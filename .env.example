# Optional. Export these before starting the API (or put them in .env and
# load it in your shell). Most of this can be entered in the app instead (Settings:
# AI keys, Notifications, Data sources); env values win and show as "set on
# server". Names are the config fields in upper case (marketmyna/core/config.py).

# AI: keys pasted in Settings -> AI keys are used first. Without one, this
# model is used (e.g. a local Ollama: LLM_MODEL=ollama/qwen3:8b).
# LLM_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Extra market data (all optional; the app works without them).
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_KEY=
# TWELVEDATA_API_KEY=

# Alerts and scheduled reports.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# EMAIL_SENDER=
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_RECEIVERS=

# Where the app keeps its data: the SQLite database, settings, caches
# (default ~/.marketmyna).
# MARKETMYNA_HOME=

# Stocks analysed in parallel by a scheduled run (default: up to 4 by CPU count).
# SCHEDULER_WORKERS=

# A 64-character key for encrypting saved secrets (openssl rand -hex 32).
# Without it a key file is created next to the database; keep it with the
# database when you back up or move ~/.marketmyna.
# SECRET_KEY=
